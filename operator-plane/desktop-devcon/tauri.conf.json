{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/tooling/cli/schema.json",
  "productName": "ARH MAKAN DevCon",
  "version": "2.3.0",
  "identifier": "com.arh.makan.devcon",
  "build": {
    "frontendDist": "../../devcon",
    "devUrl": "http://localhost:8787/devcon/"
  },
  "app": {
    "windows": [
      {
        "title": "ARH-MAKAN · Developer Console & Operator HUD",
        "width": 1280,
        "height": 840,
        "resizable": true,
        "fullscreen": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
